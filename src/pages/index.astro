---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import { BOARD_NAME, STICKY_COLORS, type Ghost } from '../board/protocol';
import '../styles/board.css';

const user = Astro.locals.user;
const colo = (Astro.request.cf?.colo as string | undefined) ?? 'localhost';

// Where every note sits, so the loading placeholders match the real board. If the board can't be
// reached, the page falls back to a generic cluster and the socket's first sync does the rest.
let ghosts: Ghost[] | null = null;
try {
	ghosts = await env.BOARD.getByName(BOARD_NAME).layout();
} catch {
	ghosts = null;
}
const bounds = ghosts?.length
	? [
			Math.min(...ghosts.map((g) => g.x)),
			Math.min(...ghosts.map((g) => g.y)),
			Math.max(...ghosts.map((g) => g.x + g.w)),
			Math.max(...ghosts.map((g) => g.y + g.h)),
		]
	: null;
/** Placeholder text lines for a note of this height. */
const lines = (h: number, lineHeight: number, max: number) => Math.max(1, Math.min(max, Math.floor(h / lineHeight)));
const widths = ['82%', '64%', '74%', '58%', '70%', '46%'];
---

<Base title="Carlos bday card">
	<div id="app" data-user={user ? JSON.stringify({ id: user.id, name: user.name }) : ''}>
		<div id="viewport" data-tool="select">
			<div id="world"></div>
			{
				ghosts && (
					<div id="ghosts" aria-hidden="true" data-bounds={bounds ? JSON.stringify(bounds) : undefined}>
						{ghosts.map((g, n) => {
							const box = `left:${g.x}px;top:${g.y}px;width:${g.w}px;z-index:${Math.round(g.z)};--i:${Math.min(n, 12)}`;
							if (g.type === 'sticky')
								return (
									<div class="gh gh-sticky" style={`${box};height:${g.h}px;--c:${g.color ?? STICKY_COLORS[0]}`}>
										{Array.from({ length: lines(g.h - 70, 24, 5) }, (_, k) => <i style={`width:${widths[k]}`} />)}
										<i class="sk-by" />
									</div>
								);
							if (g.type === 'text')
								return (
									<div class:list={['gh gh-text', { boxed: g.boxed }]} style={`${box};height:${g.h}px`}>
										{Array.from({ length: lines(g.h - (g.boxed ? 48 : 0), 29, 4) }, (_, k) => <i style={`width:${widths[k + 1]}`} />)}
									</div>
								);
							return (
								<div class="gh gh-photo" style={box}>
									<b style={`height:${g.h}px`} />
									<i style="width:40%" />
								</div>
							);
						})}
					</div>
				)
			}
		</div>
		{/* Frames the placeholders before first paint, the same way board.ts frames the real notes. */}
		<script is:inline>
			(() => {
				const g = document.getElementById('ghosts');
				if (!g) return;
				const b = g.dataset.bounds && JSON.parse(g.dataset.bounds);
				let x = innerWidth / 2, y = innerHeight / 2, z = 1;
				if (b) {
					z = Math.max(0.1, Math.min(1, (innerWidth - 96) / (b[2] - b[0]), (innerHeight - 220) / (b[3] - b[1])));
					x = innerWidth / 2 - ((b[0] + b[2]) / 2) * z;
					y = innerHeight / 2 - 20 - ((b[1] + b[3]) / 2) * z;
				}
				g.style.transform = `translate(${x}px, ${y}px) scale(${z})`;
				g.dataset.view = JSON.stringify({ x, y, z });
				const v = document.getElementById('viewport');
				v.style.backgroundSize = `${24 * z}px ${24 * z}px`;
				v.style.backgroundPosition = `${x}px ${y}px`;
				v.classList.toggle('far', z < 0.5);
			})();
		</script>
		<div id="cursors"></div>

		{/* Generic placeholder for when the layout above couldn't be fetched. Faded out by board.ts. */}
		<div id="skeleton" role="status" aria-label="Loading the card" hidden={ghosts !== null}>
			<div class="sk-cluster" aria-hidden="true">
				<div class="sk sk-sticky" style="--i: 0; --c: #fff3a3; left: 0; top: 14px; rotate: -2deg">
					<i style="width: 82%"></i><i style="width: 64%"></i><i style="width: 72%"></i><i class="sk-by"></i>
				</div>
				<div class="sk sk-sticky" style="--i: 1; --c: #ffc7c2; left: 196px; top: 0; rotate: 1.5deg">
					<i style="width: 70%"></i><i style="width: 86%"></i><i class="sk-by"></i>
				</div>
				<div class="sk sk-photo" style="--i: 2; left: 400px; top: 24px; rotate: 2.5deg">
					<b></b><i style="width: 40%"></i>
				</div>
				<div class="sk sk-sticky" style="--i: 3; --c: #c2e5ff; left: 22px; top: 210px; rotate: 1deg">
					<i style="width: 76%"></i><i style="width: 58%"></i><i class="sk-by"></i>
				</div>
				<div class="sk sk-text" style="--i: 4; left: 214px; top: 232px">
					<i style="width: 150px"></i><i style="width: 104px"></i>
				</div>
			</div>
		</div>

		<button class="corner top-left panel" id="info-open" title="About this card">
			<span class="logo" aria-hidden="true">
				<svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true">
					<path fill="#f38020" d="M43.6 41.8c.4-1.3.2-2.5-.4-3.4-.6-.8-1.6-1.3-2.8-1.3l-22.6-.3c-.1 0-.3-.1-.3-.2-.1-.1-.1-.2 0-.3.1-.2.2-.3.4-.3l22.8-.3c2.7-.1 5.6-2.3 6.6-5l1.3-3.4c.1-.1.1-.3 0-.4C47.2 20.6 41.5 16 34.7 16c-6.3 0-11.6 4-13.5 9.6-1.2-.9-2.8-1.4-4.5-1.3-3 .3-5.4 2.7-5.7 5.7-.1.8 0 1.5.2 2.2C6.4 32.4 2 36.9 2 42.5c0 .5 0 1 .1 1.5 0 .2.2.4.4.4h41.7c.2 0 .5-.2.5-.4z"></path>
					<path fill="#faae40" d="M51.1 26.4h-.6c-.1 0-.3.1-.3.3l-.9 3.1c-.4 1.3-.2 2.5.4 3.4.6.8 1.6 1.3 2.8 1.3l4.8.3c.1 0 .3.1.3.2.1.1.1.2 0 .3-.1.2-.2.3-.4.3l-5 .3c-2.7.1-5.6 2.3-6.6 5l-.4 1c-.1.2.1.4.3.4h17.2c.2 0 .4-.1.4-.3.3-1.1.5-2.2.5-3.4 0-6.8-5.6-12.2-12.5-12.2"></path>
				</svg>
			</span>
			<span class="title">Carlos bday card</span>
			<svg class="chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg>
		</button>

		<header class="corner top-right panel">
			<div id="presence"></div>
			{
				user ? (
					<button class="btn-ghost" id="sign-out" title={`Signed in as ${user.email}`}>
						Sign out
					</button>
				) : (
					<a class="btn-ghost" href="/login">
						Sign in
					</a>
				)
			}
			<button class="icon-btn" id="export" title="Export as PNG" aria-label="Export as PNG">
				<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2.5v8.5M5.5 7.5 9 11l3.5-3.5M3 12.5v1.5a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.5v-1.5"></path></svg>
			</button>
			<button class="btn-primary" id="share">Share</button>
		</header>

		<div id="palette" class="panel" hidden></div>
		<nav id="toolbar" class="panel" aria-label="Tools">
			<button data-tool="select" title="Move (V)">
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M4.5 3.5 16 8.6l-5.3 1.6-2.1 5.3z"></path></svg>
			</button>
			<button data-tool="hand" title="Hand (H, or hold Space)">
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9.5V4.8a1.2 1.2 0 0 1 2.4 0v4.2V3.8a1.2 1.2 0 0 1 2.4 0V9 5a1.2 1.2 0 0 1 2.4 0v6.5c0 3-2 5-5 5-2.3 0-3.6-1-4.7-2.7L3 10.6a1.2 1.2 0 0 1 2-1.3L7 11.5"></path></svg>
			</button>
			{
				user ? (
					<>
						<span class="sep" />
						<button data-tool="sticky" title="Sticky note (S)" class="sticky-tool">
							<span id="sticky-chip" />
						</button>
						<button data-tool="text" title="Text (T)">
							<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4.5 5V3.8h11V5M10 3.8v12.4M7.8 16.2h4.4" /></svg>
						</button>
						<button id="upload-btn" title="Photo or video (or drop / paste anywhere)">
							<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><rect x="2.8" y="4" width="14.4" height="12" rx="1.5" /><path d="m3 14 4.2-4.2 3 3 2.3-2.3L17 15" /><circle cx="13" cy="7.6" r="1.2" /></svg>
						</button>
					</>
				) : (
					<>
						<span class="sep" />
						<a class="btn-primary cta" href="/login">Sign the card</a>
					</>
				)
			}
		</nav>

		<div id="selection-bar" class="panel" hidden></div>

		<div class="corner bottom-right panel zoom">
			<button id="zoom-out" class="btn-ghost" title="Zoom out (-)">−</button>
			<button id="zoom-label" class="btn-ghost" title="Zoom to fit (Shift+1)">100%</button>
			<button id="zoom-in" class="btn-ghost" title="Zoom in (+)">+</button>
		</div>

		<dialog id="info" class="panel">
			<form method="dialog">
				<button class="close icon-btn" aria-label="Close">✕</button>
			</form>
			<h2>How this card is made</h2>
			<p class="stack">Workers · D1 · KV · R2 · Durable Objects · Turnstile · served from <b>{colo}</b></p>
			<ul>
				<li><b>Workers</b> runs the whole site (Astro, which Cloudflare owns)</li>
				<li><b>D1</b> keeps everyone's accounts</li>
				<li><b>KV</b> remembers who is signed in</li>
				<li><b>R2</b> stores the photos and videos</li>
				<li><b>Durable Objects</b> sync the board live and store every note</li>
				<li><b>Turnstile</b> keeps bots from signing the card</li>
			</ul>
			<p class="muted">No Vercel was harmed in the making of this card.</p>
			<h3>Shortcuts</h3>
			<p class="muted keys">
				<kbd>V</kbd> move · <kbd>H</kbd> or hold <kbd>Space</kbd> pan · <kbd>S</kbd> sticky · <kbd>T</kbd> text ·
				double-click to edit · <kbd>Del</kbd> delete · <kbd>Ctrl</kbd>+scroll or pinch to zoom · drop or paste photos
			</p>
		</dialog>

		<div id="offline" class="panel">Reconnecting…</div>
		<div id="toast" class="panel" role="status" hidden></div>
		<input type="file" id="file" accept="image/*,video/*" multiple hidden />
	</div>
</Base>

<script>
	import '../scripts/board';
</script>
