{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "carlos-bd",
	// Custom entry: Astro's handler + the BoardRoom Durable Object + the board WebSocket route.
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },

	// Accounts (users table). IDs are filled in by Wrangler's auto-provisioning on first deploy.
	"d1_databases": [{ "binding": "DB", "database_name": "carlos-bd-auth", "migrations_dir": "migrations" }],

	// Sessions, keyed by a hash of the session cookie.
	"kv_namespaces": [{ "binding": "KV" }],

	// Uploaded images and videos.
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "carlos-bd-media" }],

	// One Durable Object per board: realtime sync, presence, and SQLite storage of the notes.
	"durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "BoardRoom" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],

	// Workers Rate Limiting for auth endpoints and the site password.
	"ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],

	"vars": {
		// Turnstile test key that always passes. Replace with your real site key before deploying.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
	}
}
